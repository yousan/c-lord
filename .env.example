# Discord Bot Configuration
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_CHANNEL_ID=your-channel-id-here
# Identity guard (#323, optional but recommended when running multiple bots,
# e.g. prod + staging on one host): the bot's own Discord user id. If the
# process logs in as a DIFFERENT bot (e.g. a production token leaked into the
# environment of a staging launch), it exits immediately instead of running
# as the wrong identity.
# EXPECTED_BOT_USER_ID=123456789012345678

# Claude Code CLI Configuration
CLAUDE_COMMAND=claude
CLAUDE_MODEL=sonnet
# Reasoning effort passed to the CLI as --effort. One of: low, medium, high,
# xhigh, max. Unset (default) passes no flag — the CLI's own default applies.
# CLAUDE_EFFORT=max
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_WORKING_DIR=

# Delivery bridge (#216, #492): how Claude's answers reach Discord.
# "jsonl" (default, no need to set this) tails Claude Code's own JSONL
# transcript and mirrors it to the thread — reliable, no cooperation needed
# from Claude. "skill" is the legacy path (#53): a discord-reply skill is
# injected and Claude must actively call it (curl POST /api/reply) at the
# end of every turn to reach Discord — kept as an opt-in fallback only.
# CLORD_BRIDGE_MODE=jsonl

# Access Control
# DISCORD_OWNER_ID must be your numeric Discord user ID (snowflake) — NOT your
# username. To find it: enable Developer Mode (User Settings → Advanced →
# Developer Mode), then right-click your username in Discord → Copy User ID.
# Example: DISCORD_OWNER_ID=123456789012345678
# DISCORD_OWNER_ID=                   # Bot owner (always allowed); leave blank to allow everyone
# CLORD_ALLOWED_ROLE=claude-operator  # Discord role name (members with this role can use bot)

# Limits
#
# ⚠️ MAX_CONCURRENT_SESSIONS は「常駐する claude の本数」ではありません。
#    これは **同時に走るターン数** の上限で、セマフォはターンの実行だけを包み、
#    ターンが終われば解放されます — tmux の claude はその後も生き続けます。
#    常駐プロセス数の上限は CLORD_MAX_RESIDENT_WORKSPACES のほう (#576)。
MAX_CONCURRENT_SESSIONS=3
SESSION_TIMEOUT_SECONDS=300

# Session Directory Management
# SESSION_DIR_BASE is used by ChannelRepoCog as the parent directory for
# per-channel clone directories.  Bind channels via /clord-init.
# SESSION_DIR_BASE=/tmp/clord-sessions
#
# DEPRECATED — use /clord-init instead of global env vars:
# SESSION_SOURCE_REPO=/home/user/my-repo   (no longer used)
# SESSION_CLONE_BRANCH=main                (no longer used)

# Tmux Session Management (enabled by default, degrades gracefully)
# CLORD_TMUX_ENABLED=true          # Set to "false" to disable
# CLORD_TMUX_SESSION_NAME=         # Defaults to current directory name
# CLORD_TMUX_SCREENSHOT_ROWS=100   # /tmux-screenshot height in rows. The live
#                                  # window is ~40 rows, so the window is grown
#                                  # to this height before capture to show more
#                                  # history, then restored. Set 0 to capture
#                                  # the current window as-is. Default: 100

# --- Workspace lifecycle (#540) --------------------------------------------
# A workspace is everything tied to one thread: the Claude session, the working
# directory, and any docker dev environment started from it. Three operations,
# each containing the one above it:
#
#   スリープ  claude を止める                 (自動 4時間 / 手動コマンドなし)
#   停止      + docker も止める                (自動 7日   / /workspace-stop)
#   削除      + 作業ディレクトリも消す          (自動 30日  / /workspace-delete)
#
# 会話履歴と docker volume はどの操作でも消えません。
#
# The day/hour thresholds are plain constants, NOT derived from your host: they
# come from how long people leave a thread before coming back (measured p95 =
# 2.4h; only 0.49% of returns exceed 7 days), which does not change with RAM.
# Set a value to 0 to disable that step entirely.
# CLORD_IDLE_SLEEP_HOURS=4                 # スリープまでの時間。0 でスリープを無効化
#                                          # 小数可 (0.5 = 30分)。claude だけ止め、
#                                          # docker は動いたまま。次の投稿で無言復元。
#                                          # See docs/specs/workspace-sleep.md
# CLORD_IDLE_STOP_DAYS=7                   # 停止までの日数。0 で自動停止を無効化
#                                          # See docs/specs/workspace-vocabulary.md
#
# 削除には二つ目の掃除がある (#613)。上の「削除」は sessions の行を消すときに
# その行が指すディレクトリも消すので、**行を先に失ったディレクトリには永久に
# 届かない**。本番では 313 件・17.3 GB がそこに溜まっていた。この掃除はそれを
# 拾う。消すのは「行が無い」かつ「git の worktree がクリーン」かつ「30日以上
# 触られていない」ものだけで、未コミットの変更があるもの・git ですらないもの
# は残す。6時間ごとに走る。
# CLORD_ORPHAN_SWEEP_DAYS=30               # 行の無いディレクトリを消すまでの日数
#                                          # 0 でこの掃除だけを無効化
#
# 上の TTL が主たる制御で、下は**暴走時のバックストップ** (#576)。同時に claude を
# 抱えていられるワークスペースの本数に上限を置き、超えたら「いちばん長く使われて
# いないもの」からスリープさせる。**新規の作成は絶対に待たされない**（待ちキューを
# 入れると、いま普通にできている並行作業が塞がれるため）。走っているターンは選ばない。
#
# ⚠️ TTL と違い **この値だけはホスト規模に依存する**ので、既定は固定値ではなく
#    MemTotal（コンテナなら cgroup の制限を優先）からの自動算出:
#      N = max(2, floor(MemTotal_GiB × 0.4 / 0.45))
#    2GiB→2 / 8GiB→7 / 16GiB→14 / 31GiB→27 / 47GiB→41。算出結果は起動ログに出る。
#    固定既定値を配ると、それより小さいホストを壊す。明示するのは、自分のホストで
#    測って決めたときだけにすること。
# CLORD_MAX_RESIDENT_WORKSPACES=30         # 常駐上限。0 で無効。未設定なら自動算出
#                                          # See docs/specs/resident-cap.md

# 同じリポジトリのクローンは git オブジェクトを共有する (#643)。スレッドごとに
# クローンすると同じ中身を何十個も持つことになる — 本番では1リポジトリの240
# クローンだけで .git が 39.2 GB あった。同じものの全履歴 bare ミラーは 256 MB
# しかない。<セッション root>/.mirrors/ にリポジトリ1種につき1個ミラーを置き、
# クローンに --reference-if-able で参照させる。1クローンの .git は 233 MB →
# 1.2 MB になり、ネットワーク転送が消えるのでクローンは**速くなる** (実測 3.8 秒)。
# 利用者から見た動きは変わらない (branch/commit/push/pull すべて同じ)。
# ミラーが作れなければ黙って今までどおりクローンする。ミラーを消しても作業
# ファイルと未コミットの変更は無傷で、次のクローン時に自動で作り直される。
# 詳細は docs/specs/git-object-mirrors.md
# CLORD_GIT_MIRRORS=0                      # オブジェクト共有を無効化 (既定: 有効)

# --- Status lamps 🟢🟡 -------------------------------------------------
# There are TWO lamps. Only the second one is configurable here.
#
# 1. Turn lamp (#246) — an emoji REACTION on the message you sent.
#    🟢 running → 🟡 waiting. ALWAYS ON, no setting, nothing to configure.
#    This is the real-time lamp: reactions use a different Discord rate-limit
#    bucket than renames, so it can update every turn without penalty.
#
# 2. Thread-name lamp — the leading emoji of the thread NAME
#    (🟢 running / 🟡 waiting / 🔴 error / ⚪ dead). **OFF by default (#329).**
#    Every state change renames the Discord thread, and Discord rate-limits
#    thread renames hard (~2 per 10 min per thread). On a busy server that
#    saturates the limit, the lamp sticks on a stale state, and message
#    delivery gets dragged down with it (#241). Leave it off unless you run
#    few threads and specifically want the sidebar view. The thread topic name
#    is shown either way, so turning it off loses no information.
#
# See docs/specs/thread-lamp.md for the full "how this should behave".
# CLORD_THREAD_LAMP=1                      # "1"/"true"/"yes"/"on" to enable
# CLORD_THREAD_STATE_SYNC=1                # ≤60s poll that refreshes the lamp
#                                          # (only runs when CLORD_THREAD_LAMP is on)
# CLORD_THREAD_STATE_SYNC_INTERVAL=60      # Poll interval in seconds

# --- Owner fallback notifications (#525) --------------------------------
# Who gets @-mentioned for a turn NOBODY HUMAN asked for (webhook / CI /
# scheduler / POST /api/spawn). A turn a person asked for always mentions
# that person, whatever this is set to.
#   all      = owner is mentioned on turn-end AND on an interactive pause
#   blocked  = owner is mentioned only when the turn is parked waiting for a
#              decision (permission / plan / question) — DEFAULT
#   off      = never mention the owner for these turns (quiet servers running
#              many automated threads)
# CLORD_OWNER_FALLBACK=blocked

# E2E Testing (create a webhook for the DISCORD_CHANNEL_ID channel)
# E2E_TEST_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# E2E_TEST_THREAD_ID=                # Pre-attached thread ID for message-flow tests

# ─────────────────────────────────────────────────────────────────────────────
# Fuzz harness (#377) — scripts/fuzz, the hourly natural-language fuzzer.
# Set these in the STAGING clone's .env. See docs/specs/fuzz-harness.md for the
# one-time setup (create #fuzz-staging + #fuzz-report, /clord-init the inject
# channel). The harness only runs when these are present; with --dry-run it just
# generates scenarios and needs none of them.
# FUZZ_CHANNEL_ID=                   # channel to inject scenarios into (#fuzz-staging),
#                                    #   /clord-init'd to a sandbox repo. Falls back
#                                    #   to DISCORD_CHANNEL_ID if unset.
# FUZZ_REPORT_CHANNEL_ID=            # channel to post the hourly summary (#fuzz-report)
# FUZZ_GUILD_ID=                     # server id — makes thread links in the report clickable
# FUZZ_API_URL=http://127.0.0.1:8080 # staging bot's API (falls back to CLORD_API_URL)
# FUZZ_STAGING_CLONE_DIR=/home/you/c-lord-staging-1    # single clone whose scripts/staging.sh
#                                    #   manages the lease (defaults to the cwd it runs in)
# FUZZ_STAGING_CLONES=/home/you/c-lord-staging-1,/home/you/c-lord-staging-2,/home/you/c-lord-staging-3,/home/you/c-lord-staging-4
#                                    # staging FLEET (#395): harness runs on the FIRST clone it
#                                    #   can lease — a busy clone no longer wastes the hour. Each
#                                    #   clone uses its own .env. On a CLORD_BRIDGE_MODE=jsonl
#                                    #   clone the REST API is unbound, so the harness auto-uses
#                                    #   webhook+skip-health there (no --inject needed).
# FUZZ_WEBHOOK_URL=                  # only for --inject webhook (falls back to E2E_TEST_WEBHOOK_URL)
# FUZZ_TEST_THREAD_ID=               # only for --inject webhook (falls back to E2E_TEST_THREAD_ID)
# CLORD_LEASE_OWNER=fuzz-hourly      # lease identity used to borrow/release staging

# ─────────────────────────────────────────────────────────────────────────────
# Traffic monitor (#404) — scripts/monitor, the read-only anomaly monitor.
# Scans bot logs + live threads for tracebacks/errors/stuck-threads and reports
# only NEW anomalies. Read-only (no lease/inject/restart) — safe on prod + fleet.
# See docs/specs/monitor.md. With --dry-run + --logs it needs none of the below.
# MONITOR_LOGS=/tmp/clord-bot-c-lord*.log   # comma-separated log paths/globs to scan
# MONITOR_CHANNELS=                  # comma-separated channel ids to scope thread scan
# MONITOR_GUILD_ID=                  # server id — discovers active threads + clickable links
# MONITOR_REPORT_CHANNEL=            # channel to post the anomaly summary
# MONITOR_STATE_FILE=docs/monitor-runs/state.json   # incremental offset+seen state
# MONITOR_STUCK_TIMEOUT=600          # 🟢-without-🟡 seconds before THREAD_STUCK

# Skill-based reply (issue #52 — capture-pane scraping replacement, Phase 1)
# When enabled, c-lord injects a `discord-reply` skill into each session dir
# so Claude pushes its final answer to Discord via the REST API, bypassing
# the legacy capture-pane scrape path that drives most TUI chrome leaks.
# Default off — the scrape path stays primary until Phase 2.
# USE_SKILL_REPLY=true
#
# IMPORTANT: CLORD_API_URL is what gets BAKED INTO each injected SKILL.md
# (Claude curls this exact URL). CLORD_API_PORT is what the bot's API server
# BINDS TO. They are independent strings — if you change CLORD_API_PORT,
# you MUST also update CLORD_API_URL to match (and re-create any active
# session dirs to re-inject SKILL.md with the new URL).
# CLORD_API_URL=http://127.0.0.1:8080
# CLORD_API_PORT=8080
# CLORD_API_HOST=127.0.0.1
# CLORD_API_SECRET=                      # When set, SKILL.md includes a
#                                        # `Authorization: Bearer ...` header
#                                        # and the API rejects requests
#                                        # without it.
#
# URL link previews (OGP cards) in Claude's replies. Off by default — a URL in
# a reply stays inline instead of expanding into a tall OGP preview card.
# Set to 1/true/yes/on to restore Discord's default link-preview expansion.
# CLORD_SHOW_URL_EMBEDS=false
